{
  "swagger": "2.0",
  "info": {
    "title": "Presentation Assistant",
    "version": "1.1.0",
    "description": "Search existing slides, upload a PowerPoint template, create and restyle editable drafts."
  },
  "host": "api.example.invalid",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "ApiKey": {
      "type": "apiKey",
      "in": "header",
      "name": "X-API-Key"
    }
  },
  "security": [
    {
      "ApiKey": []
    }
  ],
  "paths": {
    "/api/search": {
      "post": {
        "operationId": "SearchSlides",
        "summary": "Search approved source slides",
        "x-ms-summary": "Search approved source slides",
        "description": "Search approved source slides",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "query"
              ],
              "properties": {
                "query": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 15,
                  "default": 15
                },
                "latest_only": {
                  "type": "boolean",
                  "default": true
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string"
                },
                "results": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Slide"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/api/slides/{slide_id}/versions": {
      "get": {
        "operationId": "GetSlideVersions",
        "summary": "Inspect related source versions",
        "x-ms-summary": "Inspect related source versions",
        "description": "Inspect related source versions",
        "parameters": [
          {
            "name": "slide_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "properties": {
                "slideId": {
                  "type": "string"
                },
                "versions": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Slide"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/api/templates": {
      "post": {
        "operationId": "UploadTemplate",
        "summary": "Upload a chat attachment as a PowerPoint template",
        "x-ms-summary": "Upload a chat attachment as a PowerPoint template",
        "description": "Upload a chat attachment as a PowerPoint template",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "file_name",
                "content_base64"
              ],
              "properties": {
                "file_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180,
                  "description": "Attachment file name ending in .pptx or .potx"
                },
                "content_base64": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 22369624,
                  "description": "Base64 of the original binary file, bound from a File input; never fill with AI"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Template"
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/api/drafts/{job_id}/template": {
      "post": {
        "operationId": "ApplyTemplate",
        "summary": "Apply an uploaded template to a completed draft",
        "x-ms-summary": "Apply an uploaded template to a completed draft",
        "description": "Apply an uploaded template to a completed draft",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "template_id",
                "confirmed"
              ],
              "properties": {
                "template_id": {
                  "type": "string",
                  "minLength": 32,
                  "maxLength": 32,
                  "pattern": "^[0-9a-f]{32}$",
                  "description": "Exact templateId returned by UploadTemplate for this signed-in user"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "x-nullable": true
                },
                "confirmed": {
                  "type": "boolean",
                  "enum": [
                    true
                  ],
                  "description": "True only when user explicitly requests this template for this completed draft"
                }
              }
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Job"
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/api/drafts": {
      "post": {
        "operationId": "CreateDraft",
        "summary": "Create a draft after user confirmation",
        "x-ms-summary": "Create a draft after user confirmation",
        "description": "Create a draft after user confirmation",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "title",
                "slide_ids",
                "confirmed"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "slide_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "confirmed": {
                  "type": "boolean",
                  "enum": [
                    true
                  ],
                  "description": "True only after the user explicitly approves the ordered selection"
                },
                "template_id": {
                  "type": "string",
                  "minLength": 32,
                  "maxLength": 32,
                  "pattern": "^[0-9a-f]{32}$",
                  "description": "Exact templateId returned by UploadTemplate for this signed-in user",
                  "x-nullable": true
                }
              }
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Job"
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/api/drafts/{job_id}": {
      "get": {
        "operationId": "GetDraftStatus",
        "summary": "Check draft status and file link",
        "x-ms-summary": "Check draft status and file link",
        "description": "Check draft status and file link",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Job"
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Slide": {
      "type": "object",
      "properties": {
        "slideId": {
          "type": "string"
        },
        "deckName": {
          "type": "string"
        },
        "slideNumber": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "effectiveYear": {
          "type": "integer",
          "x-nullable": true
        },
        "reportDate": {
          "type": "string",
          "x-nullable": true
        },
        "dateConfidence": {
          "type": "number"
        },
        "dateReason": {
          "type": "string"
        },
        "sourceHash": {
          "type": "string"
        },
        "freshness": {
          "type": "string"
        },
        "relatedVersions": {
          "type": "integer"
        },
        "explanation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SourceMapEntry": {
      "type": "object",
      "properties": {
        "outputSlide": {
          "type": "integer"
        },
        "slideId": {
          "type": "string"
        },
        "deckName": {
          "type": "string"
        },
        "slideNumber": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "reportDate": {
          "type": "string",
          "x-nullable": true
        },
        "effectiveYear": {
          "type": "integer",
          "x-nullable": true
        },
        "dateConfidence": {
          "type": "number"
        },
        "dateReason": {
          "type": "string"
        },
        "sourceHash": {
          "type": "string"
        }
      }
    },
    "Job": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "completed",
            "failed"
          ]
        },
        "statusUrl": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "downloadUrl": {
          "type": "string",
          "x-nullable": true
        },
        "webUrl": {
          "type": "string",
          "x-nullable": true
        },
        "error": {
          "type": "string",
          "x-nullable": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceMap": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceMapEntry"
          }
        },
        "template": {
          "type": "object",
          "properties": {
            "templateId": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "fileName": {
              "type": "string"
            },
            "slideWidth": {
              "type": "integer"
            },
            "slideHeight": {
              "type": "integer"
            },
            "layoutNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "x-nullable": true
        },
        "sourceJobId": {
          "type": "string",
          "x-nullable": true
        }
      }
    },
    "Template": {
      "type": "object",
      "properties": {
        "templateId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "fileName": {
          "type": "string"
        },
        "slideWidth": {
          "type": "integer"
        },
        "slideHeight": {
          "type": "integer"
        },
        "layoutNames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
