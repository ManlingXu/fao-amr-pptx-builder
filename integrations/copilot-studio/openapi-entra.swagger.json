{
  "swagger": "2.0",
  "info": {
    "title": "Presentation Assistant",
    "version": "1.0.0",
    "description": "Search existing slides, confirm selection, create and retrieve editable drafts."
  },
  "host": "api.example.invalid",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "EntraOAuth": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/oauth2/v2.0/authorize",
      "tokenUrl": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/oauth2/v2.0/token",
      "scopes": {
        "api://00000000-0000-0000-0000-000000000000/access_as_user": "Use the approved Presentation Assistant API as the signed-in user",
        "offline_access": "Maintain the signed-in connector connection with refresh tokens"
      }
    }
  },
  "security": [
    {
      "EntraOAuth": [
        "api://00000000-0000-0000-0000-000000000000/access_as_user",
        "offline_access"
      ]
    }
  ],
  "paths": {
    "/api/search": {
      "post": {
        "operationId": "SearchSlides",
        "summary": "Search approved source slides",
        "x-ms-summary": "Search approved source slides",
        "description": "Search approved source slides",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "query"
              ],
              "properties": {
                "query": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 15,
                  "default": 15
                },
                "latest_only": {
                  "type": "boolean",
                  "default": true
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string"
                },
                "results": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Slide"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/api/slides/{slide_id}/versions": {
      "get": {
        "operationId": "GetSlideVersions",
        "summary": "Inspect related source versions",
        "x-ms-summary": "Inspect related source versions",
        "description": "Inspect related source versions",
        "parameters": [
          {
            "name": "slide_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "properties": {
                "slideId": {
                  "type": "string"
                },
                "versions": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Slide"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/api/drafts": {
      "post": {
        "operationId": "CreateDraft",
        "summary": "Create a draft after user confirmation",
        "x-ms-summary": "Create a draft after user confirmation",
        "description": "Create a draft after user confirmation",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "title",
                "slide_ids",
                "confirmed"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "slide_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "confirmed": {
                  "type": "boolean",
                  "enum": [
                    true
                  ],
                  "description": "True only after the user explicitly approves the ordered selection"
                }
              }
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Job"
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/api/drafts/{job_id}": {
      "get": {
        "operationId": "GetDraftStatus",
        "summary": "Check draft status and file link",
        "x-ms-summary": "Check draft status and file link",
        "description": "Check draft status and file link",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Job"
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Slide": {
      "type": "object",
      "properties": {
        "slideId": {
          "type": "string"
        },
        "deckName": {
          "type": "string"
        },
        "slideNumber": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "snippet": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "effectiveYear": {
          "type": "integer",
          "x-nullable": true
        },
        "reportDate": {
          "type": "string",
          "x-nullable": true
        },
        "dateConfidence": {
          "type": "number"
        },
        "dateReason": {
          "type": "string"
        },
        "sourceHash": {
          "type": "string"
        },
        "freshness": {
          "type": "string"
        },
        "relatedVersions": {
          "type": "integer"
        },
        "explanation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "SourceMapEntry": {
      "type": "object",
      "properties": {
        "outputSlide": {
          "type": "integer"
        },
        "slideId": {
          "type": "string"
        },
        "deckName": {
          "type": "string"
        },
        "slideNumber": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "reportDate": {
          "type": "string",
          "x-nullable": true
        },
        "effectiveYear": {
          "type": "integer",
          "x-nullable": true
        },
        "dateConfidence": {
          "type": "number"
        },
        "dateReason": {
          "type": "string"
        },
        "sourceHash": {
          "type": "string"
        }
      }
    },
    "Job": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "completed",
            "failed"
          ]
        },
        "statusUrl": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "downloadUrl": {
          "type": "string",
          "x-nullable": true
        },
        "webUrl": {
          "type": "string",
          "x-nullable": true
        },
        "error": {
          "type": "string",
          "x-nullable": true
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceMap": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SourceMapEntry"
          }
        }
      }
    }
  }
}
