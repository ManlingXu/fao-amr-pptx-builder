{
  "swagger": "2.0",
  "info": {
    "title": "Presentation Assistant",
    "version": "1.3.0",
    "description": "Search and structurally analyze source slides, plan and revise storylines, confirm drafts, apply exact template layouts and review layout risks."
  },
  "host": "api.example.invalid",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "EntraOAuth": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/oauth2/v2.0/authorize",
      "tokenUrl": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/oauth2/v2.0/token",
      "scopes": {
        "api://00000000-0000-0000-0000-000000000000/access_as_user": "Use the approved Presentation Assistant API as the signed-in user",
        "offline_access": "Maintain the signed-in connector connection with refresh tokens"
      }
    }
  },
  "security": [
    {
      "EntraOAuth": [
        "api://00000000-0000-0000-0000-000000000000/access_as_user",
        "offline_access"
      ]
    }
  ],
  "paths": {
    "/api/search": {
      "post": {
        "operationId": "SearchSlides",
        "summary": "Search approved source slides",
        "x-ms-summary": "Search approved source slides",
        "description": "Search approved source slides",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "query"
              ],
              "properties": {
                "query": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 15,
                  "default": 15
                },
                "latest_only": {
                  "type": "boolean",
                  "default": true
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "properties": {
                "query": {
                  "type": "string"
                },
                "results": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Slide"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/api/slides/analyze": {
      "post": {
        "operationId": "AnalyzeSlides",
        "summary": "Inspect selected slide structure before layout decisions",
        "x-ms-summary": "Inspect selected slide structure before layout decisions",
        "description": "Inspect selected slide structure before layout decisions",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "slide_ids"
              ],
              "properties": {
                "slide_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "properties": {
                "slides": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/SlideAnalysis"
                  }
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/api/slides/{slide_id}/versions": {
      "get": {
        "operationId": "GetSlideVersions",
        "summary": "Inspect related source versions",
        "x-ms-summary": "Inspect related source versions",
        "description": "Inspect related source versions",
        "parameters": [
          {
            "name": "slide_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "properties": {
                "slideId": {
                  "type": "string"
                },
                "versions": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Slide"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/api/templates": {
      "post": {
        "operationId": "UploadTemplate",
        "summary": "Upload a chat attachment as a PowerPoint template",
        "x-ms-summary": "Upload a chat attachment as a PowerPoint template",
        "description": "Upload a chat attachment as a PowerPoint template",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "file_name",
                "content_base64"
              ],
              "properties": {
                "file_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180,
                  "description": "Attachment file name ending in .pptx or .potx"
                },
                "content_base64": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 22369624,
                  "description": "Base64 of the original binary file, bound from a File input; never fill with AI"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Template"
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/api/drafts/{job_id}/template": {
      "post": {
        "operationId": "ApplyTemplate",
        "summary": "Apply an uploaded template to a completed draft",
        "x-ms-summary": "Apply an uploaded template to a completed draft",
        "description": "Apply an uploaded template to a completed draft",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "template_id",
                "confirmed"
              ],
              "properties": {
                "template_id": {
                  "type": "string",
                  "minLength": 32,
                  "maxLength": 32,
                  "pattern": "^[0-9a-f]{32}$",
                  "description": "Exact templateId returned by UploadTemplate for this signed-in user"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "x-nullable": true
                },
                "confirmed": {
                  "type": "boolean",
                  "enum": [
                    true
                  ],
                  "description": "True only when user explicitly requests this template for this completed draft"
                },
                "layout_overrides": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "$ref": "#/definitions/LayoutOverride"
                  },
                  "description": "Optional AI-selected exact layout name for each 1-based output slide"
                }
              }
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Job"
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/api/plans": {
      "post": {
        "operationId": "PlanPresentation",
        "summary": "Propose a structured storyline grounded in approved slide searches",
        "x-ms-summary": "Propose a structured storyline grounded in approved slide searches",
        "description": "Propose a structured storyline grounded in approved slide searches",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "title",
                "audience",
                "purpose",
                "sections"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "audience": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "sections": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "$ref": "#/definitions/ProposedSection"
                  }
                },
                "template_id": {
                  "type": "string",
                  "minLength": 32,
                  "maxLength": 32,
                  "pattern": "^[0-9a-f]{32}$",
                  "description": "Exact templateId returned by UploadTemplate for this signed-in user",
                  "x-nullable": true
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Plan"
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/api/plans/{plan_id}": {
      "get": {
        "operationId": "GetPresentationPlan",
        "summary": "Retrieve the current owner-scoped storyline and revision",
        "x-ms-summary": "Retrieve the current owner-scoped storyline and revision",
        "description": "Retrieve the current owner-scoped storyline and revision",
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Plan"
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      },
      "put": {
        "operationId": "RevisePresentationPlan",
        "summary": "Replace sections and ordered slide IDs using a known revision",
        "x-ms-summary": "Replace sections and ordered slide IDs using a known revision",
        "description": "Replace sections and ordered slide IDs using a known revision",
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "expected_revision",
                "sections"
              ],
              "properties": {
                "expected_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "sections": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "items": {
                    "$ref": "#/definitions/RevisionSection"
                  }
                },
                "template_id": {
                  "type": "string",
                  "minLength": 32,
                  "maxLength": 32,
                  "pattern": "^[0-9a-f]{32}$",
                  "description": "Omit to keep the current template, null to clear it",
                  "x-nullable": true
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Plan"
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/api/plans/{plan_id}/draft": {
      "post": {
        "operationId": "CreateDraftFromPlan",
        "summary": "Create a PPT after confirming an exact storyline revision",
        "x-ms-summary": "Create a PPT after confirming an exact storyline revision",
        "description": "Create a PPT after confirming an exact storyline revision",
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "expected_revision",
                "confirmed"
              ],
              "properties": {
                "expected_revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "confirmed": {
                  "type": "boolean",
                  "enum": [
                    true
                  ],
                  "description": "Set only after explicit approval of this exact revision"
                }
              }
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Job"
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/api/drafts": {
      "post": {
        "operationId": "CreateDraft",
        "summary": "Create a draft after user confirmation",
        "x-ms-summary": "Create a draft after user confirmation",
        "description": "Create a draft after user confirmation",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "title",
                "slide_ids",
                "confirmed"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "slide_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "confirmed": {
                  "type": "boolean",
                  "enum": [
                    true
                  ],
                  "description": "True only after the user explicitly approves the ordered selection"
                },
                "template_id": {
                  "type": "string",
                  "minLength": 32,
                  "maxLength": 32,
                  "pattern": "^[0-9a-f]{32}$",
                  "description": "Exact templateId returned by UploadTemplate for this signed-in user",
                  "x-nullable": true
                }
              }
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Job"
            }
          },
          "default": {
            "description": "Request rejected or operation failed",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
