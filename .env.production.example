# CSI fills these values on the approved host. Never commit the populated file.
AUTH_MODE=entra
KNOWLEDGE_PROVIDER=sharepoint
AZURE_TENANT_ID=
# Graph application identity, with Selected permission + explicit resource grants
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Backend API application client ID; not the Graph application's ID unless deliberately reused
ENTRA_AUDIENCE=
# Configure at least one allowed role or group. Prefer a dedicated role for a controlled pilot.
ENTRA_ALLOWED_ROLES=PresentationAssistant.User
ENTRA_ALLOWED_GROUPS=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_ITEM_ID=
SHAREPOINT_OUTPUT_DRIVE_ID=
SHAREPOINT_OUTPUT_FOLDER_ITEM_ID=
SHAREPOINT_CACHE_PATH=/home/data/ppt-assistant/sharepoint-cache
DRAFTS_PATH=/home/data/ppt-assistant/drafts
# Separate admin key for reindexing; empty disables this endpoint
ADMIN_API_KEY=
# Unused in Entra mode
COPILOT_API_KEY=
