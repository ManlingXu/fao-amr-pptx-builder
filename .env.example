# Local demonstration only. Copy with scripts/setup_local.py.
# The service also validates the socket peer and Host in this mode.
AUTH_MODE=local_demo
KNOWLEDGE_PROVIDER=local
LOCAL_PRESENTATION_PATH=./data/presentations
DRAFTS_PATH=./data/drafts
ADMIN_API_KEY=
COPILOT_API_KEY=

# Graph and organizational identity stay empty in local mode.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
ENTRA_AUDIENCE=
ENTRA_ALLOWED_ROLES=
ENTRA_ALLOWED_GROUPS=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_ITEM_ID=
SHAREPOINT_CACHE_PATH=./data/sharepoint-cache
SHAREPOINT_OUTPUT_DRIVE_ID=
SHAREPOINT_OUTPUT_FOLDER_ITEM_ID=
